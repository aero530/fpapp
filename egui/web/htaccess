# Apache config for the self-hosted Financial Planner.
#
# Deployed as ".htaccess" next to index.html.  Needs "AllowOverride FileInfo
# Indexes Options" (or AllowOverride All) on the directory; if the server has
# AllowOverride None, paste these directives into the <Directory> block of the
# vhost instead and drop the file.

# Apache before 2.4.53 does not know this one, and browsers refuse to stream a
# wasm module that arrives as anything else.
AddType application/wasm .wasm
AddType text/javascript .js

# The wasm module is several megabytes of mostly-compressible bytes.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/wasm text/javascript application/javascript text/html text/css application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Deploys overwrite these files in place without changing their names, so
  # have the browser revalidate rather than risk a stale build.  ETags make the
  # usual answer a cheap 304.
  <FilesMatch "\.(html|js|wasm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Everything runs from this directory; there is no backend to talk to.
  Header set X-Content-Type-Options "nosniff"
</IfModule>

# Nothing here is meant to be browsed as a directory listing.
Options -Indexes
DirectoryIndex index.html
